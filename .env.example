# Token Shop — Facebook Group Poster
# Copy sang .env hoặc export trước khi chạy.

APP_BASE_URL=http://localhost:8080
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Admin@123456

# Gmail SMTP (App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-gmail@gmail.com

# SePay webhook + MB Bank
# Dashboard SePay → Webhooks → URL: {APP_BASE_URL}/api/sepay/webhook
# Auth header: Authorization: Apikey {SEPAY_API_KEY}
SEPAY_API_KEY=tools-facebook-2026
SEPAY_BANK=970422
SEPAY_ACCOUNT=0910108069999
SEPAY_ACCOUNT_NAME=TRAN DING HUNG

# Google OAuth (Console → OAuth client → redirect URI)
# {APP_BASE_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
